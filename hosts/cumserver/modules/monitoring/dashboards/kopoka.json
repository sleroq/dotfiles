{
  "uid": "kopoka",
  "title": "Kopoka",
  "tags": [
    "kopoka"
  ],
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Inline latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus1"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "histogram_quantile(0.95, sum by (le, inline_operation, inline_route, inline_cache) (rate(kopoka_inline_duration_seconds_bucket{job=\"kopoka\"}[$__rate_interval])))",
          "legendFormat": "{{inline_operation}} · {{inline_route}} · {{inline_cache}}",
          "range": true
        }
      ]
    },
    {
