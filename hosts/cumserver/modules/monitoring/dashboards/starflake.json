{
  "title": "Starflake",
  "uid": "starflake",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "starflake",
    "deployments"
  ],
  "description": "Read-only visibility into Starflake native releases and binary-only rollback. Rollback does not restore application data.",
  "editable": false,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus1"
        },
        "query": {
          "query": "label_values(up{job=\"starflake\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"starflake\"}, instance)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "refresh": 2,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus1"
        },
        "query": {
          "query": "label_values(starflake_active{job=\"starflake\",instance=~\"${host:regex}\"}, deployment)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(starflake_active{job=\"starflake\",instance=~\"${host:regex}\"}, deployment)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "refresh": 2,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter availability",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus1"
      },
      "description": "Minimum scrape availability across selected hosts; independent of deployment selection.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "min(up{job=\"starflake\",instance=~\"${host:regex}\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Healthy",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus1"
      },
      "description": "Count of healthy runtimes in the selected fleet. Missing series are not treated as healthy.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum(starflake_service_healthy{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
