      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Health",
            "desc": false
          },
          {
            "displayName": "Service",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(service|Value #[A-I]|revision|outcome)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #E": true,
              "Value #F": true
            },
            "indexByName": {
              "service": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "outcome": 5,
              "revision": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            },
            "renameByName": {
              "service": "Service",
              "Value #A": "Health",
              "Value #B": "Release",
              "Value #C": "Updates",
              "Value #D": "Read error",
              "outcome": "Outcome",
              "revision": "Revision",
              "Value #G": "Last attempt",
              "Value #H": "Last release",
              "Value #I": "Work duration"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Runtime health",
      "type": "state-timeline",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus1"
      },
      "description": "Runtime health over time: 1 healthy, 0 unhealthy. Missing samples remain gaps.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "starflake_service_healthy{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}",
          "legendFormat": "{{instance}} / {{deployment}}",
          "instant": false,
          "range": true,
