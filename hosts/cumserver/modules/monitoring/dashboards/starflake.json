    {
      "id": 6,
      "title": "Fleet snapshot",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus1"
      },
      "description": "Current persisted snapshot, not release or event history. Missing fields remain unknown. Rollback restores binaries only, not application data, and pauses updates. Recorded work duration may retain a prior value after paused runs or errors. Last attempt is amber after 15 minutes and red after 30 minutes (10-minute polling plus pending waits); an old last release is not a failure.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service) (label_join(starflake_service_healthy{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service) (label_join(starflake_active{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service) (label_join(starflake_paused{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service) (label_join(starflake_read_error{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service,outcome) (label_join(starflake_status{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service,revision) (label_join(starflake_current_revision{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service) (label_join(time() - starflake_last_attempt_timestamp_seconds{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service) (label_join(time() - starflake_last_success_timestamp_seconds{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum by (service) (label_join(starflake_duration_seconds{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"}, \"service\", \" / \", \"instance\", \"deployment\"))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "\u2014",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
