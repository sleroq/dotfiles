      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum(starflake_service_healthy{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"} == bool 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
