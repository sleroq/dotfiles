      "title": "Read errors",
      "type": "stat",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus1"
      },
      "description": "Read errors for selected services, including host-level errors without a deployment label.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus1"
          },
          "expr": "sum(starflake_read_error{job=\"starflake\",instance=~\"${host:regex}\",deployment=~\"${deployment:regex}\"} or starflake_read_error{job=\"starflake\",instance=~\"${host:regex}\",deployment=\"\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
