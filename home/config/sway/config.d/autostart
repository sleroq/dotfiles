# Autostart
# Import the session environment and stop its targets when Sway exits.
include /etc/sway/config.d/nixos.conf
exec sway-session-cleanup
exec swaycons

exec exec swaykbdd # Per-window keyboard layout
# exec aw-server # Activity watch server
exec nm-applet --indicator
exec swayrd # Window-switcher server
 
exec eww -c ~/.config/eww/bar daemon && exec eww -c ~/.config/eww/bar open bar

exec swww init

# Tabbed layout for 1 and 2nd workspaces
exec swaymsg layout tabbed
workspace 2
exec swaymsg layout tabbed

workspace 4
exec keepassxc

workspace 5
exec telegram-desktop
# exec signal-desktop

workspace 10
# exec noisetorch

workspace 1
