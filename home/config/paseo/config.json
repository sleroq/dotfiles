{
  "version": 1,
  "daemon": {
    "relay": {
      "enabled": true,
      "endpoint": "relay.sleroq.link:443",
      "useTls": true
    },
    "appendSystemPrompt": "Keep changes local and present their diff for review. Do not commit, push, open a pull request, or publish unless the user explicitly approves.",
    "mcp": {
      "injectIntoAgents": true
    }
  },
  "features": {
    "webUi": {
      "enabled": false
    }
  },
  "agents": {
    "providers": {
      "muse": {
        "enabled": false
      },
      "antigravity": {
        "enabled": false
      },
      "claude": {
        "enabled": false
      },
      "copilot": {
        "enabled": false
      },
      "pi": {
        "command": [
          "pi-direnv"
        ]
      },
      "opencode": {
        "command": [
          "opencode-paseo"
        ]
      },
      "codex": {
        "command": [
          "codex"
        ]
      }
    },
    "metadataGeneration": {
      "providers": [
        {
          "provider": "pi",
          "model": "opencode/gpt-6-luna",
          "thinkingOptionId": "low"
        }
      ]
    }
  }
}
