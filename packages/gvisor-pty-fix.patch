diff --git a/pkg/sentry/fsimpl/devpts/line_discipline.go b/pkg/sentry/fsimpl/devpts/line_discipline.go
index c40dca0..94e62ca 100644
--- a/pkg/sentry/fsimpl/devpts/line_discipline.go
+++ b/pkg/sentry/fsimpl/devpts/line_discipline.go
@@ -110,6 +110,11 @@ type lineDiscipline struct {
 	// numReplicas is the number of replica file descriptors.
 	numReplicas int
 
+	// replicaOpened is true once a replica has been opened.
+	//
+	// +checklocks:termiosMu
+	replicaOpened bool
+
 	// masterWaiter is used to wait on the master end of the TTY.
 	masterWaiter waiter.Queue
 
@@ -226,7 +231,7 @@ func (l *lineDiscipline) masterReadiness() waiter.EventMask {
 	// The master termios is immutable so termiosMu is not needed.
 	res := l.inQueue.writeReadiness(&linux.MasterTermios) | l.outQueue.readReadiness(&linux.MasterTermios)
 	l.termiosMu.RLock()
-	if l.numReplicas == 0 {
+	if l.replicaHungUp() {
 		res |= waiter.EventHUp
 	}
 	l.termiosMu.RUnlock()
@@ -329,6 +334,15 @@ func (l *lineDiscipline) replicaOpen() {
 	l.termiosMu.Lock()
 	defer l.termiosMu.Unlock()
 	l.numReplicas++
+	l.replicaOpened = true
+}
+
+// replicaHungUp returns true if a replica was opened and all replicas have
+// since been closed, like TTY_OTHER_CLOSED on a Linux master.
+//
+// +checklocksread:l.termiosMu
+func (l *lineDiscipline) replicaHungUp() bool {
+	return l.numReplicas == 0 && l.replicaOpened
 }
 
 // replicaClose is called when a replica file descriptor is closed.
