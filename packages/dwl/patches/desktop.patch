diff --git a/group-tabs.h b/group-tabs.h
new file mode 100644
index 0000000..942a26c
--- /dev/null
+++ b/group-tabs.h
@@ -0,0 +1,151 @@
+#include <cairo.h>
+#include <pango/pangocairo.h>
+#include <drm_fourcc.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/interfaces/wlr_buffer.h>
+
+static unsigned int workspace(Monitor *m);
+static int pane_member(Client *c, Monitor *m, int pane);
+
+typedef struct {
+	struct wlr_buffer base;
+	cairo_surface_t *image;
+} TabBuffer;
+
+static void
+tab_buffer_destroy(struct wlr_buffer *base)
+{
+	TabBuffer *buffer = wl_container_of(base, buffer, base);
+	cairo_surface_destroy(buffer->image);
+	free(buffer);
+}
+
+static bool
+tab_buffer_access(struct wlr_buffer *base, uint32_t flags, void **data,
+		uint32_t *format, size_t *stride)
+{
+	TabBuffer *buffer = wl_container_of(base, buffer, base);
+	*data = cairo_image_surface_get_data(buffer->image);
+	*format = DRM_FORMAT_ARGB8888;
+	*stride = cairo_image_surface_get_stride(buffer->image);
+	return true;
+}
+
+static void tab_buffer_end(struct wlr_buffer *base) {}
+static const struct wlr_buffer_impl tab_buffer_impl = {
+	.destroy = tab_buffer_destroy,
+	.begin_data_ptr_access = tab_buffer_access,
+	.end_data_ptr_access = tab_buffer_end,
+};
+
+static void
+group_tabs_disable(Monitor *m)
+{
+	int p;
+	for (p = 0; p < 2; p++)
+		if (m->strips[p].scene) wlr_scene_node_set_enabled(&m->strips[p].scene->node, false);
+}
+
+static void
+group_tabs_destroy(Monitor *m)
+{
+	int p;
+	for (p = 0; p < 2; p++)
+		if (m->strips[p].scene) wlr_scene_node_destroy(&m->strips[p].scene->node);
+}
+
+static void
+group_tabs_render(Monitor *m, int pane, struct wlr_box box)
+{
+	Client *c;
+	GroupStrip *strip = &m->strips[pane];
+	TabBuffer *buffer;
+	cairo_t *cr;
+	PangoLayout *text;
+	PangoFontDescription *font;
+	int count = 0, i = 0, left, right;
+	wl_list_for_each(c, &clients, link) if (pane_member(c, m, pane)) count++;
+	if (!count) return;
+	buffer = ecalloc(1, sizeof(*buffer));
+	buffer->image = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, box.width, 26);
+	wlr_buffer_init(&buffer->base, &tab_buffer_impl, box.width, 26);
+	cr = cairo_create(buffer->image);
+	text = pango_cairo_create_layout(cr);
+	font = pango_font_description_from_string("Sans 10");
+	pango_layout_set_font_description(text, font);
+	pango_layout_set_ellipsize(text, PANGO_ELLIPSIZE_END);
+	pango_layout_set_single_paragraph_mode(text, TRUE);
+	wl_list_for_each(c, &clients, link) {
+		if (!pane_member(c, m, pane)) continue;
+		left = box.width * i / count;
+		right = box.width * ++i / count;
+		cairo_save(cr);
+		cairo_rectangle(cr, left, 0, right - left, 26);
+		cairo_clip(cr);
+		if (m->tabs[workspace(m)][pane] == c) cairo_set_source_rgb(cr, c == focustop(m) ? .30 : .25, .35, .48);
+		else cairo_set_source_rgb(cr, .12, .14, .18);
+		cairo_paint(cr);
+		pango_layout_set_width(text, MAX(1, right - left - 12) * PANGO_SCALE);
+		pango_layout_set_text(text, client_get_title(c) ? client_get_title(c) : "", -1);
+		cairo_set_source_rgb(cr, .92, .92, .92);
+		cairo_move_to(cr, left + 6, 4);
+		pango_cairo_show_layout(cr, text);
+		cairo_restore(cr);
+	}
+	pango_font_description_free(font);
+	g_object_unref(text);
+	cairo_destroy(cr);
+	cairo_surface_flush(buffer->image);
+	if (!strip->scene) strip->scene = wlr_scene_buffer_create(layers[LyrTile], &buffer->base);
+	else wlr_scene_buffer_set_buffer(strip->scene, &buffer->base);
+	wlr_buffer_drop(&buffer->base);
+	strip->box = box;
+	strip->box.height = 26;
+	wlr_scene_node_set_position(&strip->scene->node, box.x, box.y);
+	wlr_scene_node_set_enabled(&strip->scene->node, true);
+}
+
+static void
+group_tabs_refresh(void)
+{
+	Monitor *m;
+	int p;
+	wl_list_for_each(m, &mons, link) for (p = 0; p < 2; p++)
+		if (m->strips[p].scene && m->strips[p].scene->node.enabled)
+			group_tabs_render(m, p, m->strips[p].box);
+}
+
+/* Invert the same floored boundaries used to draw the tab rectangles. */
+static int
+group_tab_index(int x, int width, int count)
+{
+	return ((x + 1) * count - 1) / width;
+}
+
+static int
+group_tabs_click(double x, double y)
+{
+	struct wlr_scene_node *node;
+	Monitor *m;
+	Client *c;
+	double nx, ny;
+	int p, count, index, i;
+	node = wlr_scene_node_at(&scene->tree.node, x, y, &nx, &ny);
+	wl_list_for_each(m, &mons, link) for (p = 0; p < 2; p++) {
+		GroupStrip *strip = &m->strips[p];
+		if (!strip->scene || node != &strip->scene->node) continue;
+		count = 0;
+		wl_list_for_each(c, &clients, link) if (pane_member(c, m, p)) count++;
+		index = group_tab_index((int)nx, strip->box.width, count);
+		i = 0;
+		wl_list_for_each(c, &clients, link) {
+			if (!pane_member(c, m, p) || i++ != index) continue;
+			m->tabs[workspace(m)][p] = c;
+			selmon = m;
+			arrange(m);
+			focusclient(c, 1);
+			return 1;
+		}
+	}
+	return 0;
+}
diff --git a/input-layout.h b/input-layout.h
new file mode 100644
index 0000000..c3a221c
--- /dev/null
+++ b/input-layout.h
@@ -0,0 +1,49 @@
+/* wlroots 0.20 exposes XKB state, not its internal modifier notification API.
+ * Keep connected physical/virtual keyboard states in sync with the seat group. */
+typedef struct {
+	struct wl_list link;
+	struct wlr_keyboard *keyboard;
+	struct wl_listener destroy;
+} WindowKeyboard;
+static struct wl_list window_keyboards = { &window_keyboards, &window_keyboards };
+
+static void
+window_keyboard_destroy(struct wl_listener *listener, void *data)
+{
+	WindowKeyboard *device = wl_container_of(listener, device, destroy);
+	wl_list_remove(&device->link);
+	wl_list_remove(&device->destroy.link);
+	free(device);
+}
+
+static void
+window_keyboard_track(struct wlr_keyboard *keyboard)
+{
+	WindowKeyboard *device = ecalloc(1, sizeof(*device));
+	device->keyboard = keyboard;
+	wl_list_insert(&window_keyboards, &device->link);
+	LISTEN(&keyboard->base.events.destroy, &device->destroy, window_keyboard_destroy);
+}
+
+static void
+window_keyboard_layout(struct wlr_keyboard *keyboard, xkb_layout_index_t layout)
+{
+	xkb_state_update_mask(keyboard->xkb_state, keyboard->modifiers.depressed,
+		keyboard->modifiers.latched, keyboard->modifiers.locked, 0, 0, layout);
+	keyboard->modifiers.group = xkb_state_serialize_layout(keyboard->xkb_state, XKB_STATE_LAYOUT_EFFECTIVE);
+}
+
+static void
+window_keyboard_focus(Client *c)
+{
+	WindowKeyboard *device;
+	struct wlr_keyboard *keyboard = wlr_seat_get_keyboard(seat);
+	if (!keyboard || !c) return;
+	wl_list_for_each(device, &window_keyboards, link) {
+		window_keyboard_layout(device->keyboard, c->xkb_layout);
+		if (device->keyboard->group)
+			window_keyboard_layout(&device->keyboard->group->keyboard, c->xkb_layout);
+	}
+	window_keyboard_layout(keyboard, c->xkb_layout);
+	wlr_seat_keyboard_notify_modifiers(seat, &keyboard->modifiers);
+}
diff --git a/window-state.h b/window-state.h
new file mode 100644
index 0000000..f5d5079
--- /dev/null
+++ b/window-state.h
@@ -0,0 +1,133 @@
+static int
+special_layer(Client *c)
+{
+	Client *parent = client_get_parent(c);
+	return c->isfullscreen || (parent && parent->isfullscreen) ? LyrSpecialFS : LyrSpecial;
+}
+
+/* The scrim is below every special client and above the ordinary desktop. */
+static void
+overlay_arrange(Monitor *m)
+{
+	static const float color[4] = {0.08f, 0.08f, 0.08f, 0.35f};
+	if (!m->overlay_dim && m->overlay_open)
+		m->overlay_dim = wlr_scene_rect_create(layers[LyrSpecial], m->m.width, m->m.height, color);
+	if (!m->overlay_dim) return;
+	wlr_scene_node_set_position(&m->overlay_dim->node, m->m.x, m->m.y);
+	wlr_scene_rect_set_size(m->overlay_dim, m->m.width, m->m.height);
+	wlr_scene_node_set_enabled(&m->overlay_dim->node, m->overlay_open);
+	wlr_scene_node_lower_to_bottom(&m->overlay_dim->node);
+}
+
+/* First-map placement runs before setmon saves prev or arranges maximization.
+ * It never runs again for an existing client, including unmap/remap. */
+static void
+window_initial_placement(Client *c)
+{
+	if (!c->mon || c->initially_placed || !client_surface(c)->mapped) return;
+	if (c->isfloating) {
+		Client *parent = client_get_parent(c);
+		struct wlr_box area = parent ? parent->geom : c->mon->w;
+		c->geom.x = area.x + MAX(0, (area.width - c->geom.width) / 2);
+		c->geom.y = area.y + MAX(0, (area.height - c->geom.height) / 2);
+	}
+	c->initially_placed = 1;
+	if (c->maximized) c->maximize_restore = c->geom;
+}
+
+/* Overlay membership never changes tags; hiding only disables scene nodes. */
+static void
+overlaytoggle(const Arg *arg)
+{
+	Client *c, *target = NULL;
+	Monitor *m = selmon;
+	if (!m) return;
+	if (!m->overlay_open) m->underlay_focus = focustop(m);
+	m->overlay_open ^= 1;
+	arrange(m);
+	if (m->overlay_open) {
+		target = m->overlay_focus;
+		if (!target) wl_list_for_each(c, &fstack, flink)
+			if (c->mon == m && c->overlay) { target = c; break; }
+	} else target = m->underlay_focus;
+	focusclient(target && VISIBLEON(target, m) ? target : focustop(m), 0);
+	printstatus();
+}
+
+static void
+overlaysend(const Arg *arg)
+{
+	Client *c = focustop(selmon);
+	if (!c) return;
+	if (c->overlay) {
+		c->overlay = 0;
+		wlr_scene_node_reparent(&c->scene->node, layers[c->isfullscreen ? LyrFS : LyrFloat]);
+		c->tags = selmon->tagset[selmon->seltags];
+		if (selmon->overlay_focus == c) selmon->overlay_focus = NULL;
+	} else {
+		c->overlay = 1;
+		c->isfloating = 1;
+		selmon->overlay_focus = c;
+	}
+	arrange(selmon);
+	focusclient(focustop(selmon), 0);
+	printstatus();
+}
+
+static void
+stickyToggle(const Arg *arg)
+{
+	Client *c = focustop(selmon);
+	if (!c || c->overlay) return;
+	c->sticky ^= 1;
+	arrange(selmon);
+	printstatus();
+}
+
+static void
+maximize_client(Client *c, int maximized)
+{
+	if (!c || c->isfullscreen || c->maximized == maximized ||
+			(c->type == XDGShell && !c->surface.xdg->initialized)) return;
+	c->maximized = maximized;
+	if (maximized && client_surface(c)->mapped) c->maximize_restore = c->geom;
+	if (c->type == XDGShell) wlr_xdg_toplevel_set_maximized(c->surface.xdg->toplevel, maximized);
+#ifdef XWAYLAND
+	else wlr_xwayland_surface_set_maximized(c->surface.xwayland, maximized, maximized);
+#endif
+	if (!client_surface(c)->mapped) return;
+	if (c->mon) {
+		resize(c, maximized ? c->mon->w : c->maximize_restore, 0);
+		arrange(c->mon);
+		if (maximized) wlr_scene_node_raise_to_top(&c->scene->node);
+	}
+}
+
+static void
+maximizetoggle(const Arg *arg)
+{
+	Client *c = focustop(selmon);
+	if (c) maximize_client(c, !c->maximized);
+}
+
+static void
+focusfollowtoggle(const Arg *arg)
+{
+	sloppyfocus ^= 1;
+}
+
+static void
+window_forget(Client *c)
+{
+	Monitor *m;
+	unsigned int w;
+	wl_list_for_each(m, &mons, link) {
+		if (m->overlay_focus == c) m->overlay_focus = NULL;
+		if (m->underlay_focus == c) m->underlay_focus = NULL;
+		for (w = 0; w < TAGCOUNT; w++) {
+			if (m->tabs[w][0] == c) m->tabs[w][0] = NULL;
+			if (m->tabs[w][1] == c) m->tabs[w][1] = NULL;
+		}
+	}
+	c->overlay = c->sticky = c->maximized = 0;
+}
diff --git a/workspaces.h b/workspaces.h
new file mode 100644
index 0000000..b5594b2
--- /dev/null
+++ b/workspaces.h
@@ -0,0 +1,308 @@
+/* Flat workspace panes. Client.link is the authoritative tab order. */
+static unsigned int
+workspace(Monitor *m)
+{
+	return (unsigned int)__builtin_ctz(m->tagset[m->seltags]);
+}
+
+static int
+workspace_member(Client *c, Monitor *m)
+{
+	return m && c->mon == m && !c->overlay &&
+		(c->sticky || (c->tags & m->tagset[m->seltags]));
+}
+
+static int
+pane_member(Client *c, Monitor *m, int pane)
+{
+	return workspace_member(c, m) && !c->isfloating && c->pane == pane;
+}
+
+static void
+panes_reconcile(Monitor *m)
+{
+	Client *c, *first[2] = {NULL, NULL};
+	unsigned int w = workspace(m);
+	int found[2] = {0, 0}, p;
+	wl_list_for_each(c, &clients, link) {
+		if (!workspace_member(c, m) || c->isfloating)
+			continue;
+		p = c->pane;
+		if (!first[p]) first[p] = c;
+		if (m->tabs[w][p] == c) found[p] = 1;
+	}
+	for (p = 0; p < 2; p++)
+		if (!found[p]) m->tabs[w][p] = first[p];
+	if (!first[0] && first[1]) {
+		wl_list_for_each(c, &clients, link)
+			if (pane_member(c, m, 1)) c->pane = 0;
+		m->tabs[w][0] = m->tabs[w][1];
+		m->tabs[w][1] = NULL;
+	}
+}
+
+static int
+client_visible(Client *c, Monitor *m)
+{
+	if (!m || c->mon != m) return 0;
+	if (c->overlay) return m->overlay_open;
+	if (!workspace_member(c, m)) return 0;
+	return c->isfloating || !m->lt[m->sellt]->arrange || !m->grouped[workspace(m)] ||
+		m->tabs[workspace(m)][c->pane] == c;
+}
+
+/* Rendering remains independent of the special workspace's focus barrier. */
+static int
+client_focusable(Client *c, Monitor *m)
+{
+	return client_visible(c, m) && (!m->overlay_open || c->overlay);
+}
+
+/* Unmanaged X11 surfaces have no assigned monitor. */
+static int
+client_focus_blocked(Client *c)
+{
+	Monitor *m = c->mon ? c->mon : xytomon(c->geom.x, c->geom.y);
+	return m && m->overlay_open && !c->overlay;
+}
+
+/* Each shared edge contributes 2px: 4px inner gaps, 8x4px outer gaps. */
+static struct wlr_box
+tiled_geometry(Monitor *m, struct wlr_box box)
+{
+	int left = box.x == m->w.x ? 8 : 2;
+	int top = box.y == m->w.y ? 4 : 2;
+	int right = box.x + box.width == m->w.x + m->w.width ? 8 : 2;
+	int bottom = box.y + box.height == m->w.y + m->w.height ? 4 : 2;
+	box.x += left;
+	box.y += top;
+	box.width = MAX(1, box.width - left - right);
+	box.height = MAX(1, box.height - top - bottom);
+	return box;
+}
+
+static void
+ordinary_tile(Monitor *m)
+{
+	Client *c;
+	struct wlr_box box;
+	int n = 0, i = 0, masters, width, row, count;
+	wl_list_for_each(c, &clients, link)
+		if (VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen) n++;
+	if (!n) return;
+	masters = MIN(n, m->nmaster);
+	width = n > masters ? (masters ? (int)roundf(m->w.width * m->mfact) : 0) : m->w.width;
+	wl_list_for_each(c, &clients, link) {
+		if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen) continue;
+		row = i < masters ? i : i - masters;
+		count = i < masters ? masters : n - masters;
+		box = m->w;
+		box.x += i < masters ? 0 : width;
+		box.width = i < masters ? width : m->w.width - width;
+		box.y += m->w.height * row / count;
+		box.height = m->w.height * (row + 1) / count - m->w.height * row / count;
+		resize(c, tiled_geometry(m, box), 0);
+		i++;
+	}
+}
+
+static void
+panes_arrange(Monitor *m)
+{
+	unsigned int w = workspace(m);
+	Client *c;
+	struct wlr_box box;
+	int split = m->tabs[w][1] != NULL, p;
+	float ratio = m->ratio[w] ? m->ratio[w] : 0.55f;
+	for (p = 0; p < 2; p++) {
+		c = m->tabs[w][p];
+		if (!c || c->isfullscreen) continue;
+		box = m->w;
+		if (split && m->stacked[w]) {
+			box.height = p ? m->w.height - (int)(m->w.height * ratio) : (int)(m->w.height * ratio);
+			if (p) box.y += (int)(m->w.height * ratio);
+		} else if (split) {
+			box.width = p ? m->w.width - (int)(m->w.width * ratio) : (int)(m->w.width * ratio);
+			if (p) box.x += (int)(m->w.width * ratio);
+		}
+		box = c->maximized ? m->w : tiled_geometry(m, box);
+		if (!c->maximized) {
+			group_tabs_render(m, p, box);
+			box.y += 26;
+			box.height = MAX(1, box.height - 26);
+		}
+		resize(c, box, 0);
+	}
+}
+
+static int
+group_navigation(Client *c)
+{
+	return c && c->mon->grouped[workspace(c->mon)] &&
+		c->mon->lt[c->mon->sellt]->arrange && !c->isfloating && !c->overlay;
+}
+
+static void
+pane_keep_focus(Monitor *m)
+{
+	Client *c = focustop(m);
+	if (c && !c->isfloating && !c->overlay)
+		m->tabs[workspace(m)][c->pane] = c;
+}
+
+static void
+groupmode(const Arg *arg)
+{
+	if (!selmon) return;
+	pane_keep_focus(selmon);
+	selmon->grouped[workspace(selmon)] ^= 1;
+	arrange(selmon);
+	focusclient(focustop(selmon), 1);
+}
+
+static void
+grouporientation(const Arg *arg)
+{
+	if (!selmon) return;
+	pane_keep_focus(selmon);
+	selmon->grouped[workspace(selmon)] = 1;
+	selmon->stacked[workspace(selmon)] = arg->i;
+	arrange(selmon);
+}
+
+static void
+tabcycle(const Arg *arg)
+{
+	Client *c, *sel = focustop(selmon), *next = NULL, *last = NULL;
+	int passed = 0;
+	if (!group_navigation(sel)) { focusstack(arg); return; }
+	wl_list_for_each(c, &clients, link) {
+		if (!pane_member(c, selmon, sel->pane)) continue;
+		if (!next) next = c;
+		if (c == sel) {
+			if (arg->i < 0 && last) { next = last; break; }
+			passed = 1;
+		} else if (passed && arg->i > 0) { next = c; break; }
+		last = c;
+	}
+	if (arg->i < 0 && next == sel) next = last;
+	if (!next) return;
+	selmon->tabs[workspace(selmon)][sel->pane] = next;
+	arrange(selmon);
+	focusclient(next, 1);
+}
+
+static int
+pane_neighbor(int pane, int direction)
+{
+	int next = pane + direction;
+	return next >= 0 && next < 2 ? next : -1;
+}
+
+static void
+panefocus(const Arg *arg)
+{
+	Client *sel = focustop(selmon), *next;
+	int pane;
+	if (!group_navigation(sel)) { focusstack(arg); return; }
+	pane = pane_neighbor(sel->pane, arg->i);
+	if (pane < 0) { focusstack(arg); return; }
+	next = selmon->tabs[workspace(selmon)][pane];
+	if (next) focusclient(next, 1);
+	else focusstack(arg);
+}
+
+/* Called only at a tab-list edge. A singleton left split shifts the old
+ * pane right; outward edges with two panes never create a third pane. */
+static int
+pane_cross(Client *sel, int direction)
+{
+	Monitor *m = sel->mon;
+	Client *c, *edge = NULL;
+	unsigned int w = workspace(m);
+	int next;
+	if (!m->tabs[w][1] && direction < 0) {
+		wl_list_for_each(c, &clients, link)
+			if (pane_member(c, m, 0)) c->pane = 1;
+		m->tabs[w][1] = m->tabs[w][0];
+		m->tabs[w][0] = NULL;
+		sel->pane = 0;
+	} else {
+		next = pane_neighbor(sel->pane, direction);
+		if (next < 0) return 0;
+		/* Enter the destination at its facing edge, not at an incidental
+		 * position inherited from interleaved global client order. */
+		wl_list_for_each(c, &clients, link) {
+			if (c == sel || !pane_member(c, m, next)) continue;
+			edge = c;
+			if (direction > 0) break;
+		}
+		if (edge) {
+			wl_list_remove(&sel->link);
+			wl_list_insert(direction > 0 ? edge->link.prev : &edge->link, &sel->link);
+		}
+		sel->pane = next;
+	}
+	m->grouped[w] = 1;
+	m->tabs[w][sel->pane] = sel;
+	return 1;
+}
+
+static void
+groupreorder(const Arg *arg)
+{
+	Client *c, *sel = focustop(selmon), *neighbor = NULL;
+	struct wl_list *node;
+	if (!sel || sel->isfloating || sel->overlay) return;
+	node = arg->i > 0 ? sel->link.next : sel->link.prev;
+	while (node != &clients) {
+		c = wl_container_of(node, c, link);
+		if (pane_member(c, selmon, sel->pane)) { neighbor = c; break; }
+		node = arg->i > 0 ? node->next : node->prev;
+	}
+	if (neighbor) {
+		wl_list_remove(&sel->link);
+		wl_list_insert(arg->i > 0 ? &neighbor->link : neighbor->link.prev, &sel->link);
+	} else if (!pane_cross(sel, arg->i)) {
+		return;
+	}
+	selmon->tabs[workspace(selmon)][sel->pane] = sel;
+	arrange(selmon);
+	focusclient(sel, 1);
+}
+
+static void
+groupselect(const Arg *arg)
+{
+	if (selmon) selmon->move_group ^= 1;
+}
+
+static void
+workspacetag(const Arg *arg)
+{
+	Client *c, *sel = focustop(selmon);
+	if (!sel) return;
+	if (sel->overlay) {
+		sel->overlay = 0;
+		wlr_scene_node_reparent(&sel->scene->node, layers[sel->isfullscreen ? LyrFS : LyrFloat]);
+		if (selmon->overlay_focus == sel) selmon->overlay_focus = NULL;
+	}
+	wl_list_for_each(c, &clients, link)
+		if (c == sel || (selmon->move_group && pane_member(c, selmon, sel->pane)))
+			c->tags = arg->ui & TAGMASK;
+	selmon->move_group = 0;
+	arrange(selmon);
+	focusclient(focustop(selmon), 1);
+	printstatus();
+}
+
+static void
+workspacestep(const Arg *arg)
+{
+	Arg target;
+	int next;
+	if (!selmon) return;
+	next = ((int)workspace(selmon) + arg->i + TAGCOUNT) % TAGCOUNT;
+	target.ui = 1u << next;
+	view(&target);
+}
